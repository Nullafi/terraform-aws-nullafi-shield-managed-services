# Local .terraform directories
**/.terraform/*
.terraform.lock.hcl

# Terraform state
*.tfstate
*.tfstate.*
*.tfplan

# Crash log files
crash.log
crash.*.log

# tfvars often contain sensitive values
*.tfvars
*.tfvars.json
!*.tfvars.example

# Backend config (contains environment-specific bucket/region)
*.hcl

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Secrets and certificates
.env
.env.*
*.key
*.crt
*.pem
*.pfx
!examples/**/*.example

# OS
.DS_Store
